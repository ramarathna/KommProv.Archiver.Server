@page "/archive"
@using KommProv.Archiver.Server.Data
@inject RuleArchivingService ArchiveService
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject UserSessionService UserSession

<h3>Archivierung von Regeln</h3>

<div class="form-group">
    <label>Startdatum:</label>
    <input type="date" @bind="startDate" class="form-control" />
</div>
<div class="form-group">
    <label>Enddatum:</label>
    <input type="date" @bind="endDate" class="form-control" />
</div>
<div class="form-group">
    <label>Provider ID (optional):</label>
    <input type="text" @bind="providerId" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="Archive">Archivieren</button>

@if (!string.IsNullOrEmpty(result))
{
    <p class="mt-2">@result</p>
}

@code {
    private DateTime? startDate;
    private DateTime? endDate;
    private string providerId;
    private string result;
    private string username;

    protected override void OnInitialized()
    {
        username = UserSession.Username;
        if (!UserSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", forceLoad: true); // back to login
        }
    }

    private async Task Archive()
    {
        if (!startDate.HasValue || !endDate.HasValue)
        {
            result = "Start- und Enddatum sind erforderlich.";
            return;
        }

        var archiveId = Guid.NewGuid();
        result = await ArchiveService.ArchiveRulesAsync(startDate.Value, endDate.Value, providerId, username, archiveId);
    }
}
